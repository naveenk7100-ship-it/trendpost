# TrendPost Environment Configuration
# Copy this file to .env.local and fill in the values

# =================================================================
# Application & Routing
# =================================================================
NEXT_PUBLIC_APP_URL=
DEFAULT_TIMEZONE=

# =================================================================
# Primary AI Model Configuration (OpenRouter - Default)
# =================================================================
# OpenRouter API Key for generating original Reels, Captions, Hashtags, and Carousels
# Obtain free from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Secondary AI Model Configuration (Optional Fallback)
# Anthropic Claude API Key (optional - OpenRouter is the primary engine)
ANTHROPIC_API_KEY=

# =================================================================
# Messaging (Telegram Bot)
# =================================================================
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Initial Users Telegram Chat IDs (Can be obtained via @userinfobot)
PERSON_A_TELEGRAM_CHAT_ID=
PERSON_B_TELEGRAM_CHAT_ID=

# =================================================================
# Trend Data Providers
# =================================================================
# Google Trends: Uses public Daily RSS geo=IN by default
GOOGLE_TRENDS_GEO=

# YouTube Data API v3 (Required for YouTube Trending)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=

# Reddit API (Optional OAuth or uses standard JSON with User-Agent)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# X (Twitter) API v2 Bearer Token
X_BEARER_TOKEN=

# =================================================================
# Security & Background Cron Jobs
# =================================================================
# Secret header token to verify cron trigger requests from pg_cron or external triggers
CRON_SECRET=
REFRESH_COOLDOWN_SECONDS=
